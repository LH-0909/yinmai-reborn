647722a376619","width":1024,"height":682},"preview_available":true,"impression_available":true,"historical_authentication":"official_catalogue_record_not_independent_authentication"},{"node_id":"node-685d5eb23ad7fa510aee09935abd","label":"文帝行玺","page_url":"https://www.nywmuseum.org.cn/Collection/Details/?nid=47","official_title":"“文帝行玺”龙钮金印","accession_number":"","catalogue_record_id":"47","identifier_label":"官方条目号（非文物号）","museum":"南越王博物院","source_id":"nyw","document_id":"doc-a5fb9db56201a49e297c0f3c357b","page_sha256":"eb37c7d372f1ba5c007a9aed0826d91b60fe6d9ce99942f5a4d2612afd543f37","fetched_at":"2026-10-23T07:44:14.624503+00:00","period":"西汉南越国（前203一前111年）","period_conflict":false,"material":"金","dimensions":"印面长3.1 厘米、宽3厘米","script":"小篆","transcription":"文帝行玺","transcription_scope":"官方正文所引中文印文；原字保留，不作OCR或其他文字转写","source_excerpt":"此印为方形，饰龙钮。印面有田字界格，阴刻小篆“文帝行玺”四字。印文是铸后加工刻凿的。印钮为一S形游龙，龙首伸向印台一角。龙鳞及爪是铸后凿刻的。经电子探针测定（印台部位），含金量98%。“文帝行玺”金印出土于墓主胸部,墓主为南越文帝，证实了南越国第二代王在生前就自称文帝。该金印是我国目前所见最大的一枚西汉时期金印，是发现最早的以龙为钮的帝王玺印。","source_excerpt_is_quote":true,"source_excerpt_truncated":false,"maker":"","image_match_basis":"official_single_object_catalogue_image","usage":"Local source-linked study preview; no training or public-commercial license asserted","interpretation_note":"原文关于身世、用途和真伪的推测保留为原文观点，不提升为系统定论。","status":"available","image_url":"https://file.nywmuseum.org.cn/nyw-museum/DEM_EXHIBIT_IMG/2024-07-09/638561267258441640.png","display_url":"/assets/seal-previews/node-685d5eb23ad7fa510aee09935abd.webp","caption":"“文帝行玺”龙钮金印","width":1024,"height":673,"original_sha256":"e362e940cf6e818b2fdcb81c252f591f304eb589c3248e4c04f66c3c9646281b","preview_sha256":"873c7e36a42ea44ae277510ef5f4f0ecc2eb9a1dc8e8933ef08e59c8f2c351a2","preview_available":true,"impression_available":false,"historical_authentication":"official_catalogue_record_not_independent_authentication"},{"node_id":"node-8f27c7b5abf08b9a635433f644a4","label":"杜安居","page_url":"https://www.dpm.org.cn/collection/seal/229971.html","st