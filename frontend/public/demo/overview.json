ression_available":false,"historical_authentication":"official_catalogue_record_not_independent_authentication"},{"node_id":"node-7f605b8733e0cad2c3b0f49723bb","label":"君之信鉩","page_url":"https://www.chnmuseum.cn/zp/zpml/csp/201812/t20181218_28017.shtml","official_title":"“君之信玺”玉印","accession_number":"","catalogue_record_id":"28017","identifier_label":"官方条目号（非文物号）","museum":"中国国家博物馆","source_id":"nmc","document_id":"doc-6f1f37ff6487a22cec4d81453df6","page_sha256":"6a3bd4bce8b9e21ae547ff7fd9d426e529b01587d275fcc03899e28d5cd8d51f","fetched_at":"2026-10-23T07:44:12.744085+00:00","period":"战国（公元前403—前221年）","period_conflict":false,"material":"玉","dimensions":"高2.1厘米，印面边长2.5厘米，重20克","script":"古文大篆","transcription":"君之信鉩","transcription_scope":"官方正文所引中文印文；原字保留，不作OCR或其他文字转写","source_excerpt":"楚国官玺。玺面阴刻篆书“君之信鉩”， 覆斗形钮，坡面和印侧饰卷云纹及树叶纹，古文大篆，“君”“之”“鉩”字有楚文字风格，为楚国某封君之玺。线条细腻沉稳，篆法劲键。玉质官玺极为稀少，弥足珍贵。战国时期各国有大量封君存在，秦国后期改封君为侯。楚国封君、封邑以县为单位（战国之县相当于后世秦汉之郡），称县公，如叶公，即叶县封君；或称君者后面加私名，如《左传》记载“棠","source_excerpt_is_quote":true,"source_excerpt_truncated":true,"maker":"","image_match_basis":"official_single_object_catalogue_image","usage":"Local source-linked study preview; no training or public-commercial license asserted","interpretation_note":"原文关于身世、用途和真伪的推测保留为原文观点，不提升为系统定论。","status":"available","image_url":"https://www.chnmuseum.cn/zp/zpml/csp/201812/P020220829554558171257.jpg","display_url":"/assets/seal-previews/node-7f605b8733e0cad2c3b0f49723bb.webp","caption":"“君之信玺”玉印","width":1024,"height":1024,"original_sha256":"28492bb98eb45106869dcef9ae1a8f4359ceea09151f2768340ef8068830df9b","preview_sha256":"881ab2d8744914ee38954f165952c06e255ee9d5ed178f7ab275a455fee1fa28","preview_available":true,"impression_available":false,"historical_authentication":"official_catalogue_record_not_independent_authentication"},{"node_id":"node-9588815c924d27a7f93632629b18","label":"大府","page_url":"https://www.dpm.org.cn/collection/seal/228909.html","status":"available","official_title":"楚国铜柱钮“大府”鉨","accession_number"